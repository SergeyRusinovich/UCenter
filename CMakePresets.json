{
  "version": 3,
  "cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "description": "Qt ищется сам (Homebrew) или через CMAKE_PREFIX_PATH в CMakeUserPresets.json / окружении",
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "debug",
      "displayName": "Debug",
      "description": "Отладочная сборка в build-debug (её же по умолчанию проверяет tools/clang_tidy.sh)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-debug",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "release",
      "displayName": "Release",
      "description": "Как в README и CI: build/, предупреждения как ошибки",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release", "UCENTER_WERROR": "ON" }
    },
    {
      "name": "asan",
      "displayName": "Debug + ASan/UBSan",
      "description": "Тесты под AddressSanitizer и UBSan (не MSVC)",
      "inherits": "base",
      "binaryDir": "${sourceDir}/build-asan",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug",
        "CMAKE_CXX_FLAGS": "-fsanitize=address,undefined -fno-omit-frame-pointer"
      },
      "condition": { "type": "notEquals", "lhs": "${hostSystemName}", "rhs": "Windows" }
    }
  ],
  "buildPresets": [
    { "name": "debug", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "release", "configurePreset": "release", "configuration": "Release" },
    { "name": "asan", "configurePreset": "asan", "configuration": "Debug" }
  ],
  "testPresets": [
    {
      "name": "base",
      "hidden": true,
      "output": { "outputOnFailure": true }
    },
    { "name": "debug", "inherits": "base", "configurePreset": "debug", "configuration": "Debug" },
    { "name": "release", "inherits": "base", "configurePreset": "release", "configuration": "Release" },
    { "name": "asan", "inherits": "base", "configurePreset": "asan", "configuration": "Debug" }
  ]
}

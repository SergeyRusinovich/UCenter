<?xml version="1.0" encoding="UTF-8"?>
<!-- Права приложения под hardened runtime (подпись Developer ID, ADR 0019):
     без этого ключа macOS не даёт геопозицию подписанному с hardened runtime бандлу -->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.personal-information.location</key>
    <true/>
</dict>
</plist>

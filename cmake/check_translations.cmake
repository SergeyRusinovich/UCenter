# Тест: в каждом translations/*.ts нет непереведённых строк (type="unfinished").
# Запуск из корня проекта: cmake -P cmake/check_translations.cmake
file(GLOB ts_files "${CMAKE_CURRENT_LIST_DIR}/../translations/*.ts")
if(NOT ts_files)
    message(FATAL_ERROR "No translations/*.ts found")
endif()
set(failed FALSE)
foreach(ts IN LISTS ts_files)
    file(READ ${ts} content)
    string(REGEX MATCHALL "type=\"unfinished\"" unfinished "${content}")
    list(LENGTH unfinished count)
    get_filename_component(name ${ts} NAME)
    if(count GREATER 0)
        message(SEND_ERROR "${name}: ${count} untranslated string(s)")
        set(failed TRUE)
    else()
        message(STATUS "${name}: complete")
    endif()
endforeach()
